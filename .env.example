# For docker compose. The dev menu (dev.ps1 / dev.sh) copies this to .env if it is missing.
# Change the values in .env, never commit .env.
# Inside docker, services reach each other by service name and port 8080, like http://movies:8080

# Database passwords, one per service
USERS_DB_PASSWORD=changeme
MOVIES_DB_PASSWORD=changeme
SCREENINGS_DB_PASSWORD=changeme
RESERVATIONS_DB_PASSWORD=changeme
PAYMENTS_DB_PASSWORD=changeme
REVIEWS_DB_PASSWORD=changeme
NOTIFICATIONS_DB_PASSWORD=changeme

# Users service
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
# Admin created when users starts (only if this email does not exist yet), empty = no admin
ADMIN_EMAIL=admin@cinemago.si
ADMIN_PASSWORD=change-this-admin-password
# Max login, register or refresh calls per IP in the window, 0 = no limit
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Service URLs (USERS_URL, MOVIES_URL, ...) and LOCAL_SERVICES are not needed here.
# Compose uses the containers by default and the dev menu sets them for local runs.
