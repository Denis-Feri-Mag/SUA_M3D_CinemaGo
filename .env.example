# Copy this file to .env and fill in the values.
# Inside docker, services reach each other by service name and port 8080, like http://movies:8080

# Database passwords, one per service
USERS_DB_PASSWORD=changeme
MOVIES_DB_PASSWORD=changeme
SCREENINGS_DB_PASSWORD=changeme
RESERVATIONS_DB_PASSWORD=changeme
PAYMENTS_DB_PASSWORD=changeme
REVIEWS_DB_PASSWORD=changeme
NOTIFICATIONS_DB_PASSWORD=changeme

# Users service
JWT_SECRET=change-this-to-a-long-random-string
NOTIFICATIONS_URL=http://notifications:8080
ACCESS_TOKEN_MINUTES=15
