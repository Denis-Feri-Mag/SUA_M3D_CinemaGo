# Copy this file to .env and fill in the values.

# Example database password for a service (change per service later)
MOVIES_DB_PASSWORD=changeme

# Example URL another service would call (inside docker use the service name and its container port)
MOVIES_URL=http://movies:8080

# Users service
USERS_DB_PASSWORD=changeme
JWT_SECRET=change-this-to-a-long-random-string
NOTIFICATIONS_URL=http://notifications:8080
ACCESS_TOKEN_MINUTES=15
