# Local run only. Copy to .env in this folder, inside docker compose sets these instead.
# The DB password must match NOTIFICATIONS_DB_PASSWORD in the root .env.

PORT=8087
DB_URL=postgres://m3d_notifications:changeme@localhost:5438/m3d_notifications

# Other services, from a local run they are on localhost with their dev port
USERS_URL=http://localhost:8081
