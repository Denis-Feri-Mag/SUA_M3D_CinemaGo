# Local run only (cargo run). Copy to .env in this folder, inside docker compose sets these instead.
# The DB password must match USERS_DB_PASSWORD in the root .env.

PORT=8081
DB_URL=postgres://m3d_users:changeme@localhost:5432/m3d_users
# Required, use the same value as in the root .env
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
# Valkey from the dev compose (port 6379)
CACHE_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
# Admin created on start if this email does not exist yet, empty = no admin
ADMIN_EMAIL=admin@cinemago.si
ADMIN_PASSWORD=change-this-admin-password
# Max login, register or refresh calls per IP in the window, 0 = no limit
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Other services, from a local run they are on localhost with their dev port
NOTIFICATIONS_URL=http://localhost:8087

# Optional log level
# RUST_LOG=info,sqlx=warn
