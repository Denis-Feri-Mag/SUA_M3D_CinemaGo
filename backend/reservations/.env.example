# Local run only (cargo run). Copy to .env in this folder, inside docker compose sets these instead.
# The DB password must match RESERVATIONS_DB_PASSWORD in the root .env.

PORT=8084
DB_URL=postgres://m3d_reservations:changeme@localhost:5435/m3d_reservations

# Other services, from a local run they are on localhost with their dev port
SCREENINGS_URL=http://localhost:8083

# Optional log level
# RUST_LOG=info,sqlx=warn
